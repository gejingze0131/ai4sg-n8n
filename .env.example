# ---- n8n ----
N8N_VERSION=2.40.5
N8N_HOST=localhost
N8N_PROTOCOL=http
# Set to true once n8n is served over HTTPS; false lets you log in over plain http from another LAN machine
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Singapore

# setup.sh replaces every CHANGE_ME below with a random value on first run
N8N_ENCRYPTION_KEY=CHANGE_ME
RUNNERS_AUTH_TOKEN=CHANGE_ME

# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=CHANGE_ME
# database that holds the collected AI4SG projects
AI4SG_DB=ai4sg

# ---- OpenAI (required for the pipeline) ----
# Web search and document reading use OpenAI's Responses API, so this must be an OpenAI key
# (other OpenAI-compatible providers do not offer the built-in web search tool).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Website (web/) ----
# The first administrator: this address, with the password below. The account is created when the site first starts,
# and nobody can register with this address. Change the password on the site after the first sign-in.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=CHANGE_ME
# open = choosing "expert" at sign-up takes effect at once; approval = an administrator approves it first
EXPERT_SIGNUP=open
# Not used yet: set to true and fill SMTP_* to require e-mail verification. SMTP_* alone enables password reset.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Map base layer (any MapLibre style); applied when the site is built
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
BETTER_AUTH_SECRET=CHANGE_ME
# the key the website and n8n share; every n8n webhook except the old read-only audit page requires it
N8N_WEBHOOK_SECRET=CHANGE_ME
WEB_DB_RO_PASSWORD=CHANGE_ME
WEB_DB_RW_PASSWORD=CHANGE_ME

# ---- Sharing with other people ----
AI4SG_PAGE_USER=ai4sg
AI4SG_PAGE_PASSWORD=CHANGE_ME
# Public address of this machine; ./share.sh on fills it in. Empty = local use only.
PUBLIC_URL=

# ---- Codex search agent (B · Search) ----
# Each search task runs as one Codex CLI session in the codex-runner container, using OPENAI_API_KEY above.
CODEX_SEARCH_MODEL=gpt-6-luna
CODEX_SEARCH_REASONING=high
# sessions at once, and the time limit per search task (minutes)
CODEX_MAX_PARALLEL=3
CODEX_TIMEOUT_MIN=20
CODEX_VERSION=0.161.0

# ---- Fixed academic databases (Europe PMC, OpenAlex, ERIC; used by the search agent) ----
# Europe PMC and ERIC need no key. OpenAlex charges each search against a daily budget (about 100 searches a day
# without a key). A free OpenAlex account gives an API key with 10x that budget: paste it here (optional).
OPENALEX_API_KEY=
# optional e-mail sent to OpenAlex with each request
SCHOLAR_MAILTO=
