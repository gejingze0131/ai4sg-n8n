      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO skills (name, version, content, status, change_note, created_by)\nSELECT $1, coalesce(max(version), 0) + 1, $2, 'draft', 'auto-drafted from weekly reviews', 'ai'\nFROM skills WHERE name = $1",
        "options": {
          "queryReplacement": "={{ [ $('Build Revision Prompt').item.json.name, $json.text ] }}"
        }
