      "id": "b26bc0cf-501f-560d-bd93-66e00532f4dc",
      "name": "Expert · Publish Skill",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        410
      ],
      "webhookId": "b877acf6-b9ca-53d6-8e85-ec585fd617b4"
