{
  "id": "ai4sgSkillEvo001",
  "name": "AI4SG · 5 Skill Evolution",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## 5 · Skill Evolution (versioning and improvement of both skills)\nTop row (weekly, automatic): collect expert review corrections + expert-vs-AI extraction differences → per-field agreement rates → LLM **drafts** a skill revision → saved as draft.\nBottom row (manual): an expert reviews the draft or uploads a new skill text → on approval it becomes the active version. **Only expert-approved versions are used by search and extraction.**\nEvery AI output records the skill version that produced it, so errors can be traced back to a specific rule set.",
        "width": 1700,
        "height": 123,
        "color": 7
      },
      "id": "2c85ee2b-758e-58eb-adfd-da0d4d86d37e",
      "name": "Note · overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -193
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggersAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "4c3b4345-e972-5692-8c92-876101b70c72",
      "name": "Weekly Mon 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.decision, r.corrections, r.reason, e.fields, e.skill_version, g.fields AS gold\nFROM reviews r JOIN extractions e ON e.id = r.extraction_id\nLEFT JOIN gold_extractions g ON g.source_id = e.source_id\nWHERE r.created_at > now() - interval '7 days'",
        "options": {}
      },
      "id": "207719b5-713a-5f78-a073-db1a90f6f7c6",
      "name": "Load Reviews & Disagreements",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "ai4sgPostgres001",
          "name": "AI4SG Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Per field: how often experts approved it unchanged vs corrected it; top correction reasons\nconst stats = {};\nfor (const { json: r } of $input.all()) {\n  if (!r.decision) continue;\n  for (const f of Object.keys(r.fields || {})) {\n    stats[f] ??= { total: 0, corrected: 0, reasons: [] };\n    stats[f].total++;\n    if (r.corrections && f in r.corrections) { stats[f].corrected++; if (r.reason) stats[f].reasons.push(r.reason); }\n  }\n}\nreturn [{ json: { stats, n_reviews: $input.all().length } }];\n"
      },
      "id": "49580e26-1b05-54ef-b1c4-5cea572e2248",
      "name": "Field Agreement Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT ON (name) name, version, content FROM skills WHERE status = 'active' ORDER BY name, version DESC",
        "options": {}
      },
      "id": "11605954-6c57-5002-b485-f00f9ff3f81f",
      "name": "Load Active Skills",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "ai4sgPostgres001",
          "name": "AI4SG Postgres"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const stats = $('Field Agreement Stats').first().json;\nreturn $input.all().map(({ json: s }) => ({ json: { name: s.name, base_version: s.version,\n  prompt: `You maintain the \"${s.name}\" skill used by an AI pipeline. Experts reviewed its outputs this week.\\n` +\n          `Field-level correction stats: ${JSON.stringify(stats.stats)}\\n\\nCurrent skill:\\n${s.content}\\n\\n` +\n          `Propose a revised skill. Change only what the corrections justify; list each change with its reason at the top.` } }));\n"
      },
      "id": "94cc5a32-ab42-5064-8bfa-4d9b6f900130",
      "name": "Build Revision Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
