    {
      "parameters": {
        "jsCode": "// Pull the machine-readable block (e.g. ```json coverage``` in the search skill) out of the Markdown\nconst f = $input.first().json;\nconst text = f['Skill text (Markdown)'] || '';\nconst m = text.match(/```json[^\\n]*\\n([\\s\\S]*?)```/);\nreturn [{ json: { name: f['Skill'], action: f['Action'], content: text, config: m ? JSON.parse(m[1]) : null,\n                  note: f['What changed and why'], by: f['Your name'] } }];\n"
      },
      "id": "10450a4c-684e-5b22-8ec8-38bb66aefd54",
      "name": "Parse Skill Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        410
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH new AS (\n  INSERT INTO skills (name, version, content, config, status, change_note, created_by)\n  SELECT $1, coalesce(max(version), 0) + 1, $2, $3::jsonb, 'active', $4, $5\n  FROM skills WHERE name = $1 AND $6 = 'publish text below'\n  RETURNING name, version),\napprove AS (\n  UPDATE skills SET status = 'active', change_note = $4, approved_by = $5\n  WHERE $6 = 'approve latest draft' AND name = $1\n    AND version = (SELECT max(version) FROM skills WHERE name = $1 AND status = 'draft')\n  RETURNING name, version)\nUPDATE skills SET status = 'retired'\nWHERE name = $1 AND status = 'active'\n  AND version < (SELECT max(version) FROM (SELECT version FROM new UNION ALL SELECT version FROM approve) v)",
        "options": {
          "queryReplacement": "={{ [ $json.name, $json.content, JSON.stringify($json.config), $json.note, $json.by, $json.action ] }}"
        }
      },
      "id": "817e8109-7adc-5355-a0b4-428a4be3e47f",
      "name": "Save & Activate Version",
