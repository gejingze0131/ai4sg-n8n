      },
      "id": "73c71c56-895e-52eb-82b5-edc38a488128",
      "name": "Extract HTML Text",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Unify both branches into {url, title, text, lang, chars}; detect script so local-language sources are flagged\nconst SCRIPTS = [[/[ঀ-৿]/g, 'bn'], [/[ऀ-ॿ]/g, 'hi'], [/[฀-๿]/g, 'th'], [/[஀-௿]/g, 'ta']];\nreturn $input.all().map(({ json }) => {\n  const text = String(json.text || '').replace(/\\s+/g, ' ').trim().slice(0, 60000);\n  let lang = 'latin';\n  for (const [re, code] of SCRIPTS) if ((text.match(re) || []).length > 200) { lang = code; break; }\n  if (lang === 'latin' && /\\b(yang|dan|untuk|dengan|tidak)\\b/gi.test(text.slice(0, 5000))) lang = 'id';\n  if (lang === 'latin') lang = 'en';\n  return { json: { url: $('When called with a URL').first().json.url, title: json.title || '', text, lang, chars: text.length } };\n});\n"
      },
      "id": "d1ba52f7-7d60-5f0c-9072-a2a7083a1712",
      "name": "Clean & Detect Language",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    }
