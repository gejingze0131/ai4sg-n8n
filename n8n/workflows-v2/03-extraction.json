        "query": "UPDATE sources SET status = 'processing', claimed_at = now()\nWHERE id IN (SELECT id FROM sources WHERE status = 'queued'\n             ORDER BY priority DESC, created_at LIMIT 20 FOR UPDATE SKIP LOCKED)\nRETURNING *",
