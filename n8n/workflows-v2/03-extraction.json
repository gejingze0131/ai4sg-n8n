    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT g.fields, s.title, s.language, left(s.fulltext, 3000) AS excerpt\nFROM gold_extractions g JOIN sources s ON s.id = g.source_id\nWHERE g.use_as_example ORDER BY g.created_at DESC LIMIT 4",
        "options": {}
