    },
    {
      "parameters": {
        "content": "### 🧑‍🔬 F · Review decision: POST /webhook/ai4sg/review/decision",
        "width": 1180,
        "height": 230,
        "color": 4
      },
      "id": "e99db0a9-22ea-529a-9a46-3d670f0a2b66",
      "name": "Hook F",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        730
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai4sg/review/decision",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "6ea0f0bd-4aa4-5ca4-a8cc-fc273dd5711d",
      "name": "Review Decision",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        810
      ],
      "webhookId": "4e466032-2f68-53c2-907e-2e1c9ce276f4"
    },
    {
      "parameters": {
        "jsCode": "// body: {extraction_id, decision: approve|edit|reject, corrections: {field: new_value}, reason, reviewer}\nconst b = $input.first().json.body || {};\nif (!['approve', 'edit', 'reject'].includes(b.decision) || !b.extraction_id || !b.reviewer) throw new Error('invalid decision payload');\nreturn [{ json: { ...b, corrections: b.corrections || {} } }];\n"
      },
      "id": "cb7a382e-5976-5571-86d3-4864f65d8196",
      "name": "Validate Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        810
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH r AS (\n  INSERT INTO reviews (extraction_id, reviewer, decision, corrections, reason)\n  VALUES ($1, $2, $3, $4::jsonb, $5) RETURNING extraction_id)\nUPDATE extractions SET status = CASE $3 WHEN 'reject' THEN 'rejected' ELSE 'approved' END,\n       final_fields = CASE $3 WHEN 'reject' THEN NULL ELSE fields || $4::jsonb END, reviewed_at = now()\nWHERE id = (SELECT extraction_id FROM r)",
        "options": {
          "queryReplacement": "={{ [ $json.extraction_id, $json.reviewer, $json.decision, JSON.stringify($json.corrections), $json.reason ] }}"
        }
      },
      "id": "660f20a9-d54a-5ffa-844c-175d624f76d2",
      "name": "Save Review",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        810
      ],
      "credentials": {
        "postgres": {
          "id": "ai4sgPostgres001",
          "name": "AI4SG Postgres"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={\"ok\":true}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "0cf10e1a-cb8f-5420-bcae-8257d72cb7e9",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        810
      ]
    }
