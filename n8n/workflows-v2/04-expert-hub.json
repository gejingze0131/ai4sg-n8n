    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nreturn [{ json: { url: f['Source URL'], expert: f['Your name'], use_as_example: f['Use as example for the AI?'] === 'yes',\n  fields: { project_name: f['Project name'], countries: [f['Country']], cost_text: f['Cost (amount, currency, what it covers)'],\n            benefit_text: f['Benefit (outcome, metric, magnitude, comparison)'], evidence_type: f['Evidence type'],\n            quotes: f['Key quotes (original language)'], interpretation: f['Your interpretation / caveats'] } } }];\n"
      },
      "id": "afedd8c6-393c-5fdc-97ed-b9802f3e5f1b",
      "name": "Map to Extraction Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        270
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (\n  INSERT INTO sources (url, url_norm, provenance, submitted_by, priority, status)\n  VALUES ($1, lower(regexp_replace($1, '/$', '')), 'expert', $2, 10, 'queued')\n  ON CONFLICT (url_norm) DO UPDATE SET priority = 10 RETURNING id)\nINSERT INTO gold_extractions (source_id, expert, fields, use_as_example)\nSELECT id, $2, $3::jsonb, $4 FROM s",
        "options": {
          "queryReplacement": "={{ [ $json.url, $json.expert, JSON.stringify($json.fields), $json.use_as_example ] }}"
        }
      },
      "id": "e4f90036-99cc-5792-904f-2da0e4634e3e",
      "name": "Save Gold Extraction",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
