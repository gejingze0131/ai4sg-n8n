      "position": [
        0,
        0
      ],
      "webhookId": "76f4361d-e4d5-5a4f-9add-fe84e87e5c23"
    },
    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst url = f['URL'] || null;\nreturn [{ json: { url, url_norm: url ? url.replace(/#.*$/, '').replace(/\\/$/, '').toLowerCase() : null,\n  country: f['Country'], source_type: f['Source type'], why_relevant: f['Why it matters (your note)'],\n  submitted_by: f['Your name'], has_pdf: !!$input.first().binary } }];\n"
      },
      "id": "aa6f946b-b18d-573a-92db-018a551e8731",
      "name": "Normalize Submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sources (url, url_norm, source_type, country, why_relevant, provenance, submitted_by, priority, status)\nVALUES ($1, $2, $3, $4, $5, 'expert', $6, 10, 'queued')\nON CONFLICT (url_norm) DO UPDATE SET priority = 10, provenance = 'expert', submitted_by = EXCLUDED.submitted_by",
        "options": {
          "queryReplacement": "={{ [ $json.url, $json.url_norm, $json.source_type, $json.country, $json.why_relevant, $json.submitted_by ] }}"
        }
      },
      "id": "22e2545a-69a4-550e-b762-57e7577d4f84",
