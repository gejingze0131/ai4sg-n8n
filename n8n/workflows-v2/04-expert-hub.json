    {
      "parameters": {
        "content": "### 🧑‍🔬 E · Audit page (MVP front end): GET /webhook/ai4sg/review",
        "width": 1180,
        "height": 230,
        "color": 4
      },
      "id": "a9cc8023-f0d6-5c36-962b-0cdad0db988a",
      "name": "Hook E",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        460
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "ai4sg/review",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c60ab72f-f719-575e-bfa0-570c5ef513ee",
      "name": "Audit Page",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        540
      ],
      "webhookId": "92f9242d-74f2-53fe-a115-b19480fa7552"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT e.id, e.fields, e.flags, e.confidence, e.skill_version, s.url, s.title, s.country, s.language,\n       s.source_type, s.provenance, left(s.fulltext, 20000) AS fulltext\nFROM extractions e JOIN sources s ON s.id = e.source_id\nWHERE e.status = 'pending_review'\nORDER BY s.provenance = 'expert' DESC, e.confidence ASC LIMIT 50",
        "options": {}
      },
      "id": "a603b217-92c4-576c-aa93-32d979548c76",
      "name": "Load Review Queue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        540
      ],
      "credentials": {
        "postgres": {
          "id": "ai4sgPostgres001",
          "name": "AI4SG Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// MVP: one card per extraction — fields on the left, source text with quotes highlighted on the right,\n// buttons POST to /webhook/ai4sg/review/decision. (Full page template to be filled in the build step.)\nconst rows = $input.all().map(i => i.json).filter(r => r.id);\nreturn [{ json: { contentType: 'text/html; charset=utf-8', body: `<!doctype html><title>AI4SG Audit</title><pre>${rows.length} items pending review</pre>` } }];\n"
      },
      "id": "03eb8726-c655-5fdf-aef4-00737a0ccba4",
      "name": "Render Audit Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        540
      ]
    },
    {
