                "value": "={{ $json.contentType }}"
              }
            ]
          }
        }
      },
      "id": "31c052c5-87c2-5235-a0a9-e6b82d521429",
      "name": "Respond Page",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        540
