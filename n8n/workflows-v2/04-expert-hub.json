  "nodes": [
    {
      "parameters": {
        "content": "## 4 · Expert Hub (all expert entry points)\nFour independent entry points:\n**C Submit source**: articles / PDFs the experts found by hand go into the same queue, with priority.\n**D Manual extraction**: an expert fills in an extraction using their own framework, saved as a gold example; the AI also extracts the same source so the two can be compared.\n**E Audit page**: shows each AI extraction with its source quotes for the expert to check.\n**F Review decision**: approve / edit / reject; field-level corrections and reasons are recorded and later drive skill improvements.",
        "width": 1480,
        "height": 165,
        "color": 7
      },
      "id": "3f5cf494-49c4-5dd5-beae-8eaba14f900d",
      "name": "Note · overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
