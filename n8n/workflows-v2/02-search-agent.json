    {
      "parameters": {
        "jsCode": "const t = $('When called by Orchestrator').first().json;\nconst skill = $input.first().json;\nreturn [{ json: {\n  system_prompt: skill.content,\n  task: `Country: ${t.country}\\nSearch language: ${t.language}\\nSource type: ${t.source_type}\\n` +\n        `Preferred domains: ${t.domains || '(none)'}\\n` +\n        `Find AI-for-social-good projects, deployments, evaluations or policies matching this task, following the skill. ` +\n        `Search in the local language first, then English. Read each promising page before listing it. ` +\n        `Return up to 15 candidates.`,\n}}];\n"
      },
