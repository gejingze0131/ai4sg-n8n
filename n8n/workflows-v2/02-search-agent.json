    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"candidates\"\n  ],\n  \"properties\": {\n    \"candidates\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"url\",\n          \"title\",\n          \"source_type\",\n          \"country\",\n          \"language\",\n          \"why_relevant\"\n        ],\n        \"properties\": {\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"title_en\": {\n            \"type\": \"string\"\n          },\n          \"source_type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"news\",\n              \"journal\",\n              \"open_source\",\n              \"gov_website\",\n              \"conference_report\",\n              \"gov_report\",\n              \"ngo_report\",\n              \"other\"\n            ]\n          },\n          \"country\": {\n            \"type\": \"string\"\n          },\n          \"language\": {\n            \"type\": \"string\"\n          },\n          \"published\": {\n            \"type\": \"string\"\n          },\n          \"why_relevant\": {\n            \"type\": \"string\",\n            \"description\": \"1-2 sentences, English\"\n          },\n          \"search_query\": {\n            \"type\": \"string\",\n            \"description\": \"the query that found it\"\n          }\n        }\n      }\n    }\n  }\n}"
      },
      "id": "28cf27e0-a27c-544d-9ac0-98901de80c75",
      "name": "Candidate List Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1520,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Drop malformed rows, normalise URLs for dedupe, stamp provenance\nconst t = $('When called by Orchestrator').first().json;\nconst out = [];\nfor (const c of ($input.first().json.output?.candidates || [])) {\n  if (!/^https?:\\/\\//.test(c.url || '')) continue;\n  const u = new URL(c.url); u.hash = '';\n  ['utm_source', 'utm_medium', 'utm_campaign', 'fbclid', 'gclid'].forEach((k) => u.searchParams.delete(k));\n  out.push({ json: { ...c, url_norm: u.toString().replace(/\\/$/, '').toLowerCase(), skill_version: Number(t.skill_version) } });\n}\nreturn out;\n"
      },
      "id": "6a9df261-96f4-5348-b4bc-f7893280e5d4",
      "name": "Validate & Tag Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ]
    }
