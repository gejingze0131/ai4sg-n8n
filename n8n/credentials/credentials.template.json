[
  {
    "id": "ai4sgPostgres001",
    "name": "AI4SG Postgres",
    "type": "postgres",
    "data": {
      "host": "postgres",
      "port": 5432,
      "database": "__AI4SG_DB__",
      "user": "__PG_USER__",
      "password": "__PG_PASSWORD__",
      "ssl": "disable",
      "allowUnauthorizedCerts": false,
      "sshTunnel": false
    }
  },
  {
    "id": "ai4sgOpenAiApi01",
    "name": "AI4SG LLM (OpenAI-compatible)",
    "type": "openAiApi",
    "data": {
      "apiKey": "__OPENAI_API_KEY__",
      "url": "__OPENAI_BASE_URL__"
    }
  },
  {
    "id": "ai4sgPageAuth001",
    "name": "AI4SG Page Login",
    "type": "httpBasicAuth",
    "data": {
      "user": "__PAGE_USER__",
      "password": "__PAGE_PASSWORD__"
    }
  },
  {
    "id": "ai4sgWebhookKey01",
    "name": "AI4SG Webhook Key",
    "type": "httpHeaderAuth",
    "data": {
      "name": "X-AI4SG-Key",
      "value": "__N8N_WEBHOOK_SECRET__"
    }
  }
]
