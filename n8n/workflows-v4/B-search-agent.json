      "credentials": {
        "openAiApi": {
          "id": "ai4sgOpenAiApi01",
          "name": "AI4SG LLM (OpenAI-compatible)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pull the JSON answer out of the response, one item per candidate, with a normalised URL for de-duplication\nconst j = $input.first().json;\nconst text = j.output?.flatMap(o => o.content || []).find(c => c.type === 'output_text')?.text ?? j.text ?? '';\nlet list = []; try { list = JSON.parse(text).candidates || []; } catch (e) {}\nreturn list.filter(c => /^https?:\\/\\//.test(c.url || ''))\n  .map(c => ({ json: { ...c, url_norm: c.url.replace(/#.*$/, '').replace(/[?&]utm_[^&]+/g, '').replace(/\\/$/, '').toLowerCase() } }));\n"
      },
