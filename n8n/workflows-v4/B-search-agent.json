            {
              "type": "text",
              "role": "user",
              "content": "=Country: {{ $json.country }}\nSearch language: {{ $json.language }}\nSource type: {{ $json.source_type }}\nFind AI-for-social-good projects, deployments, evaluations or policies for this task, following your instructions. Open each promising page or PDF before listing it. Return up to 15 candidates."
            }
          ]
        },
        "options": {
          "instructions": "={{ $json.search_skill }}",
          "maxToolCalls": 30,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "result",
              "schema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"candidates\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"candidates\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"url\",\n          \"title\",\n          \"source_type\",\n          \"format\",\n          \"country\",\n          \"language\",\n          \"why_relevant\"\n        ],\n        \"properties\": {\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"source_type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"news\",\n              \"journal\",\n              \"open_source\",\n              \"gov_website\",\n              \"gov_report\",\n              \"conference_report\",\n              \"ngo_report\",\n              \"other\"\n            ]\n          },\n          \"format\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"html\",\n              \"pdf\"\n            ]\n          },\n          \"country\": {\n            \"type\": \"string\"\n          },\n          \"language\": {\n            \"type\": \"string\"\n          },\n          \"why_relevant\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
              "strict": false
            }
          }
        },
        "builtInTools": {
          "webSearch": {
            "searchContextSize": "high",
            "country": "={{ $json.country_code }}"
          }
        }
      },
      "id": "cb4a9449-dd00-5d35-8fa3-a85c638dcd24",
      "name": "Search the Web",
      "type": "@n8n/n8n-nodes-langchain.openAi",
