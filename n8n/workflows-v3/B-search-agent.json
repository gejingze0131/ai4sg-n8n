        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ai4sgGithubTok01",
          "name": "AI4SG GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "toolDescription": "Open a web page or PDF and return its text. Input: the URL.",
        "url": "=https://r.jina.ai/{{ $fromAI('url', 'URL to read', 'string') }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "e977c558-590a-5825-8fd8-25980caac085",
      "name": "Read Page",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"candidates\"\n  ],\n  \"properties\": {\n    \"candidates\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"url\",\n          \"title\",\n          \"source_type\",\n          \"country\",\n          \"language\",\n          \"why_relevant\"\n        ],\n        \"properties\": {\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"source_type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"news\",\n              \"journal\",\n              \"open_source\",\n              \"gov_website\",\n              \"gov_report\",\n              \"conference_report\",\n              \"ngo_report\",\n              \"other\"\n            ]\n          },\n          \"country\": {\n            \"type\": \"string\"\n          },\n          \"language\": {\n            \"type\": \"string\"\n          },\n          \"why_relevant\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
      },
      "id": "91b318dd-41e8-51ca-930f-e13c37119d81",
      "name": "Candidate List",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One item per candidate, with a normalised URL for de-duplication\nreturn ($input.first().json.output?.candidates || [])\n  .filter(c => /^https?:\\/\\//.test(c.url || ''))\n  .map(c => ({ json: { ...c, url_norm: c.url.replace(/#.*$/, '').replace(/[?&]utm_[^&]+/g, '').replace(/\\/$/, '').toLowerCase() } }));\n"
      },
      "id": "306385f9-5a54-5eca-ba58-effecb9fdf39",
      "name": "Clean Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        40
      ]
    }
