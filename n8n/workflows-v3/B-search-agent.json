          "id": "ai4sgSearxng0001",
          "name": "AI4SG SearXNG"
        }
      }
    },
    {
      "parameters": {
        "toolDescription": "Search journal articles and conference papers (OpenAlex). Input: search terms in any language.",
        "url": "https://api.openalex.org/works",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "search",
              "value": "={{ $fromAI('query', 'search terms', 'string') }}"
            },
            {
              "name": "per-page",
              "value": "15"
            }
          ]
        },
        "options": {}
      },
      "id": "fe91f33c-46d8-5d33-a5c0-cf0ab99c607f",
      "name": "Scholarly Search",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "toolDescription": "Search open-source repositories on GitHub. Input: a GitHub search query.",
        "url": "https://api.github.com/search/repositories",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $fromAI('query', 'GitHub search query', 'string') }}"
            },
            {
              "name": "per_page",
              "value": "15"
            }
          ]
        },
        "options": {}
      },
      "id": "5c88b5a9-3be7-5b2e-96c7-302c69019643",
      "name": "GitHub Search",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
