{
  "id": "ai4sgSearchAgt01",
  "name": "AI4SG · B Search Agent",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## B · Search Agent\nCalled once per task, e.g. **Bangladesh × bn × gov_report**. The agent's instructions are the expert **Search Skill**; it chooses the queries (local language first, then English), the sites and which pages to open.\nTools cover the source types: web & news search (government sites, reports, news), scholarly search (journals, conference papers), GitHub (open-source projects), and Read Page to open any web page or PDF.\nOutput: a list of candidate sources, each with type, country, language and why it is relevant.",
        "width": 1360,
        "height": 150
      },
      "id": "3bb879d8-362b-5313-8fec-1d4a0babd24c",
      "name": "Note · title",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -290
      ]
    },
    {
      "parameters": {
        "content": "### 🧑‍🔬 Search Skill in\nThe full text of `skills/search/SKILL.md` arrives here and becomes the agent's system prompt.",
        "width": 400,
        "height": 270,
        "color": 4
      },
      "id": "697f39e3-9a78-5bd0-a29f-aeb13d46e715",
      "name": "Skill in",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -110
      ]
    },
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "search_skill"
            },
            {
              "name": "country"
            },
            {
              "name": "language"
            },
            {
              "name": "source_type"
            }
          ]
        }
      },
      "id": "ad52354e-78e7-596d-9dde-2ab82647227b",
      "name": "Task + Search Skill",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Country: {{ $json.country }}\nSearch language: {{ $json.language }}\nSource type: {{ $json.source_type }}\nFind AI-for-social-good projects, deployments, evaluations or policies for this task, following your instructions. Open each promising page before listing it. Return up to 15 candidates.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "={{ $json.search_skill }}",
          "maxIterations": 20
        }
      },
      "id": "5f6cbe8e-8152-52db-bf10-d5f9f5c116b1",
      "name": "Search Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
