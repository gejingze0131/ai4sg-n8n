    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- drop sources seen in earlier runs, take turns across the searches, keep at most \"Max sources to analyse\"\nWITH cand AS (\n  SELECT r.*, o.ord\n  FROM jsonb_array_elements($1::jsonb) WITH ORDINALITY AS o(j, ord),\n       jsonb_to_record(o.j) AS r(url text, url_norm text, title text, title_en text, source_type text, format text,\n                                 country text, language text, why_relevant text)\n  WHERE r.url_norm IS NOT NULL\n), fresh AS (\n  SELECT DISTINCT ON (url_norm) * FROM cand\n  WHERE NOT EXISTS (SELECT 1 FROM sources s WHERE s.url_norm = cand.url_norm)\n  ORDER BY url_norm, ord\n), picked AS (\n  SELECT *, row_number() OVER (PARTITION BY country, language, source_type ORDER BY ord) AS turn FROM fresh\n  ORDER BY turn, ord\n  LIMIT $2::int\n)\nINSERT INTO sources (url, url_norm, title, title_en, source_type, format, country, language, why_relevant)\nSELECT url, url_norm, title, title_en, source_type, format, country, language, why_relevant FROM picked ORDER BY turn, ord\nON CONFLICT (url_norm) DO NOTHING\nRETURNING id AS source_id, url, format, country, language",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($input.all().map(i => i.json)), $('Plan Search Tasks').first().json.max_sources ] }}"
        }
      },
