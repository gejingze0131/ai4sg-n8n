    {
      "parameters": {
        "jsCode": "// Run page answers + the Search Skill's country list -> one search task per country x language x source type\nconst form = $('Run page').first().json;\nconst skill = $input.first().json.data;\nlet registry;\ntry { registry = JSON.parse(skill.match(/```json countries\\s*([\\s\\S]*?)```/)[1]).countries; }\ncatch (e) { throw new Error('Search Skill: the \"json countries\" block is missing or is not valid JSON'); }\nconst list = (v) => (Array.isArray(v) ? v : String(v || '').split(/[,;\\n]+/)).map(s => String(s).trim()).filter(Boolean);\nconst num = (v, d) => (Number(v) > 0 ? Number(v) : d);\nconst known = (n) => registry.find(c => [c.name, c.iso].some(k => String(k || '').toLowerCase() === n.toLowerCase()));\n// a country missing from the Search Skill's list is still searched, in English only\nconst countries = [...new Map([...list(form['Countries']), ...list(form['Other countries'])]\n  .map(n => known(n) || { name: n, iso: '', local_languages: [] }).map(c => [c.name, c])).values()];\nif (!countries.length) throw new Error('Run page: choose at least one country');\nconst TYPES = {\"News\": \"news\", \"Government reports (PDF)\": \"gov_report\", \"Government websites\": \"gov_website\", \"Journal papers\": \"journal\", \"Conference reports\": \"conference_report\", \"Open-source code & data\": \"open_source\"};\nconst types = list(form['Source types']).map(t => TYPES[t]).filter(Boolean);\nconst langs = list(form['Search languages']);\nconst settings = {\n  focus: form['Topic focus'] || '',\n  since_year: num(form['Published from (year)'], ''),\n  max_results: num(form['Max results per search'], 10),\n  max_sources: num(form['Max sources to analyse'], 10),\n  min_relevance: Number((String(form['Relevance screen'] || '').match(/[\\d.]+/) || ['0.6'])[0]),\n};\n// order: all countries first, then languages, then source types, so \"Max web searches\" drops whole source types from the end\nconst tasks = [];\nfor (const source_type of types)\n  for (const which of ['Local language', 'English']) if (langs.includes(which))\n    for (const c of countries)\n      for (const language of which === 'English' ? ['en'] : (c.local_languages || []))\n        tasks.push({ search_skill: skill, country: c.name, country_code: c.iso || '', language, source_type, ...settings });\nif (!tasks.length) throw new Error('Run page: nothing to search. Choose at least one source type and one language');\nreturn tasks.slice(0, num(form['Max web searches'], 6)).map((json) => ({ json }));\n"
      },
