    {
      "parameters": {
        "jsCode": "// Search Skill (definition of AI4SG) for the screen; Extraction Skill + expert examples for the full read\nconst files = $('Load Skills + Examples').all();\nconst texts = $('Files to Text').all();\nlet searchSkill = '', skill = '', examples = [];\ntexts.forEach((t, i) => {\n  const { fileName: name, directory: dir = '' } = files[i].binary.data;\n  if (dir.endsWith('/search') && name === 'SKILL.md') searchSkill = t.json.data;\n  else if (dir.endsWith('/extraction') && name === 'SKILL.md') skill = t.json.data;\n  else if (dir.includes('/extraction') && !name.startsWith('_')) examples.push(`### Expert example: ${name}\\n${t.json.data}`);\n});\nconst src = $('Source to Process').first().json;\nconst minRelevance = Number(src.min_relevance) || 0.6;   // \"Relevance screen\" on the run page\nconst doc = String($input.first().json.text || '').replace(/\\s+/g, ' ').trim();\nconst head = `URL: ${src.url}\\nCountry: ${src.country}\\nLanguage: ${src.language}`;\nreturn [{ json: { source_id: src.source_id, fulltext: doc, min_relevance: minRelevance,\n  screen_prompt:\n    `${searchSkill}\\n\\n## Screening task\\nYou are screening ONE source before the experts' detailed review. Using the definition in ` +\n    `\"What counts as AI for Social Good\" above, decide whether this source describes a concrete AI system, project, evaluation or policy ` +\n    `whose primary purpose is a social benefit in the stated country. Generic AI news, AI policy talk without a concrete project, ` +\n    `commercial products, digitisation without a learned model, and pages that merely mention AI do not qualify.\\n` +\n    `Return: is_ai4sg (boolean), relevance (0-1: how clearly and centrally the source is about such a project), ` +\n    `reason (one English sentence), headline_en (one English sentence: who does what, max 20 words).\\n\\n## Source\\n${head}\\n\\n${doc.slice(0, 15000)}`,\n  prompt:\n    `${skill}\\n\\n## Worked examples from our experts\\n${examples.join('\\n\\n') || '(none yet)'}\\n\\n` +\n    `## Source to analyse\\n${head}\\n\\n${doc.slice(0, 60000)}` } }];\n"
      },
