    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"is_ai4sg\",\n    \"headline\",\n    \"source\",\n    \"interpretation\",\n    \"evidence\"\n  ],\n  \"properties\": {\n    \"is_ai4sg\": {\n      \"type\": \"boolean\"\n    },\n    \"headline\": {\n      \"type\": \"string\",\n      \"description\": \"one English sentence, max 20 words\"\n    },\n    \"source\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"title_original\": {\n          \"type\": \"string\"\n        },\n        \"title_en\": {\n          \"type\": \"string\"\n        },\n        \"language\": {\n          \"type\": \"string\"\n        },\n        \"publisher\": {\n          \"type\": \"string\"\n        },\n        \"published\": {\n          \"type\": \"string\"\n        },\n        \"summary_en\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"project\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"implementing_org\": {\n          \"type\": \"string\"\n        },\n        \"location\": {\n          \"type\": \"string\"\n        },\n        \"domain\": {\n          \"type\": \"string\"\n        },\n        \"ai_technique\": {\n          \"type\": \"string\"\n        },\n        \"deployment_stage\": {\n          \"type\": \"string\"\n        },\n        \"target_beneficiaries\": {\n          \"type\": \"string\"\n        },\n        \"partners\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"funders\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"countries\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"evidence_refs\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"reach\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"stated\": {\n          \"type\": \"boolean\"\n        },\n        \"number\": {\n          \"type\": [\n            \"number\",\n            \"null\"\n          ]\n        },\n        \"unit\": {\n          \"type\": \"string\"\n        },\n        \"is_target\": {\n          \"type\": \"boolean\"\n        },\n        \"evidence_refs\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"cost\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"stated\": {\n          \"type\": \"boolean\"\n        },\n        \"amount\": {\n          \"type\": [\n            \"number\",\n            \"null\"\n          ]\n        },\n        \"currency\": {\n          \"type\": \"string\"\n        },\n        \"amount_as_written\": {\n          \"type\": \"string\"\n        },\n        \"what_is_covered\": {\n          \"type\": \"string\"\n        },\n        \"cost_per_beneficiary\": {\n          \"type\": [\n            \"number\",\n            \"null\"\n          ]\n        },\n        \"evidence_refs\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"benefit\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"stated\": {\n          \"type\": \"boolean\"\n        },\n        \"outcome\": {\n          \"type\": \"string\"\n        },\n        \"metric\": {\n          \"type\": \"string\"\n        },\n        \"magnitude\": {\n          \"type\": \"string\"\n        },\n        \"comparison\": {\n          \"type\": \"string\"\n        },\n        \"outputs_reported\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"evidence_refs\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"evidence_strength\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"type\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"rct\",\n            \"quasi_experimental\",\n            \"observational\",\n            \"pilot_report\",\n            \"anecdotal\",\n            \"none\"\n          ]\n        },\n        \"rationale\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"interpretation\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"cost_benefit\": {\n          \"type\": \"string\"\n        },\n        \"credibility\": {\n          \"type\": \"string\"\n        },\n        \"gaps\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"overall\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"risks_limitations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"evidence\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"id\",\n          \"field\",\n          \"quote_original\",\n          \"quote_en\"\n        ],\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"field\": {\n            \"type\": \"string\"\n          },\n          \"quote_original\": {\n            \"type\": \"string\"\n          },\n          \"quote_en\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"self_confidence\": {\n      \"type\": \"number\"\n    }\n  }\n}"
      },
      "id": "b8ab0220-f895-571b-8541-9e370efa72b0",
      "name": "Extraction Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2400,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "// Mark each quote found / not found in the source text; flag cost/benefit claims that no verified quote supports\nconst ctx = $('Compose Prompt').first().json;\nconst x = $input.first().json.output || {};\n// compare without whitespace and punctuation spacing: text extraction can drop or add spaces (e.g. after Bengali vowel signs)\nconst norm = (s) => String(s || '').normalize('NFC').replace(/[\\s\\u200b-\\u200d]+/g, '').toLowerCase();\nconst text = norm(ctx.fulltext);\nconst evidence = (x.evidence || []).map(e => ({ ...e, found: !!e.quote_original && text.includes(norm(e.quote_original).slice(0, 100)) }));\nconst supported = (block, name) => evidence.some(e => e.found && ((block?.evidence_refs || []).includes(e.id) || e.field === name));\nconst flags = [];\nif (!$input.first().json.output) flags.push('extraction_failed');\nif ((ctx.fulltext || '').length < 150) flags.push('no_text_extracted');\nif (x.cost?.stated && !supported(x.cost, 'cost')) flags.push('cost_without_evidence');\nif (x.benefit?.stated && !supported(x.benefit, 'benefit')) flags.push('benefit_without_evidence');\nif (evidence.some(e => !e.found)) flags.push('quote_not_found');\nconst verified = evidence.length ? evidence.filter(e => e.found).length / evidence.length : 0;\nreturn [{ json: { source_id: ctx.source_id, fields: $input.first().json.output ? { ...x, evidence } : null, flags,\n                  confidence: Math.round(100 * Math.min(x.self_confidence ?? 0.5, verified)) / 100 } }];\n"
      },
      "id": "78617feb-b7f1-5b44-b99d-e4769063f755",
      "name": "Verify Evidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2560,
        40
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO extractions (source_id, fields, flags, confidence, status)\nVALUES ($1, $2::jsonb, $3::jsonb, $4, CASE WHEN $2::jsonb->>'is_ai4sg' = 'false' THEN 'filtered_out' ELSE 'pending_review' END)",
        "options": {
          "queryReplacement": "={{ [ $json.source_id, JSON.stringify($json.fields), JSON.stringify($json.flags), $json.confidence ] }}"
        }
      },
      "id": "2a5ac23f-cdd1-5617-93f3-f0ffe1d2a2b1",
