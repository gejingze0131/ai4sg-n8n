      "id": "f4f60a03-eb78-517d-afef-cf1514f168b2",
      "name": "After a Run",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM ai_projects p WHERE NOT EXISTS (SELECT 1 FROM source_projects sp WHERE sp.project_id = p.id);\nDELETE FROM ai_tools t WHERE NOT EXISTS (SELECT 1 FROM ai_projects p WHERE p.tool_id = t.id);\nSELECT p.id AS project_id FROM ai_projects p\nWHERE p.synthesis IS NULL\n   OR EXISTS (SELECT 1 FROM source_projects sp LEFT JOIN extractions e ON e.source_id = sp.source_id\n              WHERE sp.project_id = p.id AND GREATEST(sp.created_at, e.created_at) > (p.synthesis->>'built_at')::timestamptz)\nORDER BY p.id",
        "options": {}
      },
      "id": "8ad3154a-2f26-5e2a-853b-0a1ab790e78c",
