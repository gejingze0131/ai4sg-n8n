  "nodes": [
    {
      "parameters": {
        "content": "## ③ Project Summaries (stage 3 of a run, and after an analysis started from the audit page)\nRemoves deployments and tools left without sources, then summarises (C3) every deployment whose summary is missing or older than its newest source or extraction. Grouping sources into deployments and tools, and finding duplicates, now happens before the analysis (stage ②, the organiser); reviewers correct it on the audit page (move a source, merge two deployments).",
        "width": 1300,
        "height": 170
      },
      "id": "50ea63bd-ab4f-5ad2-8f95-b8e418813851",
      "name": "Note · title",
      "type": "n8n-nodes-base.stickyNote",
