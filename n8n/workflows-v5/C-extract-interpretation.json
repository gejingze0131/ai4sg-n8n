    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"is_ai4sg\",\n    \"project_name\",\n    \"cost\",\n    \"benefit\",\n    \"evidence_type\",\n    \"interpretation\",\n    \"evidence\"\n  ],\n  \"properties\": {\n    \"is_ai4sg\": {\n      \"type\": \"boolean\"\n    },\n    \"project_name\": {\n      \"type\": \"string\"\n    },\n    \"implementing_org\": {\n      \"type\": \"string\"\n    },\n    \"countries\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"domain\": {\n      \"type\": \"string\"\n    },\n    \"ai_technique\": {\n      \"type\": \"string\"\n    },\n    \"deployment_stage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"idea\",\n        \"pilot\",\n        \"scaled\",\n        \"discontinued\",\n        \"unknown\"\n      ]\n    },\n    \"target_beneficiaries\": {\n      \"type\": \"string\"\n    },\n    \"cost\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"amount\": {\n          \"type\": \"number\"\n        },\n        \"currency\": {\n          \"type\": \"string\"\n        },\n        \"what_is_covered\": {\n          \"type\": \"string\"\n        },\n        \"cost_per_beneficiary\": {\n          \"type\": \"number\"\n        },\n        \"stated\": {\n          \"type\": \"boolean\"\n        }\n      }\n    },\n    \"benefit\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"outcome\": {\n          \"type\": \"string\"\n        },\n        \"metric\": {\n          \"type\": \"string\"\n        },\n        \"magnitude\": {\n          \"type\": \"string\"\n        },\n        \"comparison\": {\n          \"type\": \"string\"\n        },\n        \"stated\": {\n          \"type\": \"boolean\"\n        }\n      }\n    },\n    \"evidence_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"rct\",\n        \"quasi_experimental\",\n        \"observational\",\n        \"pilot_report\",\n        \"anecdotal\",\n        \"none\"\n      ]\n    },\n    \"interpretation\": {\n      \"type\": \"string\",\n      \"description\": \"expert-style reading: cost-benefit judgement, caveats\"\n    },\n    \"evidence\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"field\",\n          \"quote_original\"\n        ],\n        \"properties\": {\n          \"field\": {\n            \"type\": \"string\"\n          },\n          \"quote_original\": {\n            \"type\": \"string\"\n          },\n          \"quote_en\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"self_confidence\": {\n      \"type\": \"number\"\n    }\n  }\n}"
      },
      "id": "b8ab0220-f895-571b-8541-9e370efa72b0",
      "name": "Extraction Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1900,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "// Every quote must occur in the source text; unsupported cost/benefit claims lower confidence\nconst ctx = $('Compose Prompt').first().json;\nconst x = $input.first().json.output;\nconst norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim().toLowerCase();\nconst text = norm(ctx.fulltext);\nconst checks = (x.evidence || []).map(e => ({ ...e, found: !!e.quote_original && text.includes(norm(e.quote_original).slice(0, 120)) }));\nconst has = (f) => checks.some(c => c.field.startsWith(f) && c.found);\nconst flags = [];\nif (x.cost?.stated && !has('cost')) flags.push('cost_without_evidence');\nif (x.benefit?.stated && !has('benefit')) flags.push('benefit_without_evidence');\nif (checks.some(c => !c.found)) flags.push('quote_not_found');\nconst verified = checks.length ? checks.filter(c => c.found).length / checks.length : 0;\nreturn [{ json: { source_id: ctx.source_id, fields: { ...x, evidence: checks }, flags,\n                  confidence: Math.round(100 * Math.min(x.self_confidence ?? 0.5, verified)) / 100 } }];\n"
      },
      "id": "78617feb-b7f1-5b44-b99d-e4769063f755",
      "name": "Verify Evidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2060,
        40
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO extractions (source_id, fields, flags, confidence, status)\nVALUES ($1, $2::jsonb, $3::jsonb, $4, 'pending_review')",
        "options": {
          "queryReplacement": "={{ [ $json.source_id, JSON.stringify($json.fields), JSON.stringify($json.flags), $json.confidence ] }}"
        }
      },
      "id": "2a5ac23f-cdd1-5617-93f3-f0ffe1d2a2b1",
      "name": "Save for Review",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
