      "id": "1d4383f3-264f-5c83-a014-51bee2ac59e9",
      "name": "Extract HTML Text",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        1240,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extraction Skill + expert worked examples + the document text\nconst files = $('Load Extraction Skill + Examples').all();\nconst texts = $('Files to Text').all();\nlet skill = '', examples = [];\ntexts.forEach((t, i) => {\n  const name = files[i].binary.data.fileName;\n  if (name === 'SKILL.md') skill = t.json.data; else examples.push(`### Expert example: ${name}\\n${t.json.data}`);\n});\nconst src = $('Source to Process').first().json;\nconst doc = String($input.first().json.text || '').replace(/\\s+/g, ' ').trim();\nreturn [{ json: { source_id: src.source_id, fulltext: doc, prompt:\n  `${skill}\\n\\n## Worked examples from our experts\\n${examples.join('\\n\\n') || '(none yet)'}\\n\\n` +\n  `## Source to analyse\\nURL: ${src.url}\\nCountry: ${src.country}\\nLanguage: ${src.language}\\n\\n${doc.slice(0, 60000)}` } }];\n"
      },
      "id": "d11ae1c4-08ee-5627-bf91-b6660fc53b61",
      "name": "Compose Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        40
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
