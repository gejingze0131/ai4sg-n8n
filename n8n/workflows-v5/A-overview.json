    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sources (url, url_norm, title, source_type, format, country, language, why_relevant)\nSELECT url, url_norm, title, source_type, format, country, language, why_relevant\nFROM jsonb_to_recordset($1::jsonb) AS r(url text, url_norm text, title text, source_type text, format text,\n                                        country text, language text, why_relevant text)\nON CONFLICT (url_norm) DO NOTHING\nRETURNING id AS source_id, url, format, country, language",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($input.all().map(i => i.json).filter(c => c.url_norm)) ] }}"
        }
      },
