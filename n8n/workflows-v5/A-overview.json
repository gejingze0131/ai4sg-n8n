    {
      "parameters": {
        "jsCode": "// Expand the Search Skill's coverage block into one task per country x language x source type\nconst skill = $input.first().json.data;\nconst cov = JSON.parse(skill.match(/```json coverage\\s*([\\s\\S]*?)```/)[1]);\n// cov = {countries:[{name:'Bangladesh', iso:'BD', languages:['bn','en']}, ...], source_types:[...], max_tasks_per_run: 40}\nconst tasks = [];\nfor (const c of cov.countries) for (const language of c.languages) for (const source_type of cov.source_types)\n  tasks.push({ search_skill: skill, country: c.name, country_code: c.iso, language, source_type });\nreturn tasks.slice(0, cov.max_tasks_per_run || 40).map((json) => ({ json }));\n"
      },
      "id": "e5d1fefe-fe0d-5688-b0cd-94db1f31067a",
      "name": "Plan Search Tasks",
      "type": "n8n-nodes-base.code",
