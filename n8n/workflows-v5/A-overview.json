    {
      "parameters": {
        "content": "### 🧑‍🔬 Audit page (MVP front end): GET /webhook/ai4sg\nShows every result with its source link, quotes and evidence flags, newest first, so experts can check quality and correctness. Read-only for the MVP.",
        "width": 1000,
        "height": 250,
        "color": 4
      },
      "id": "88927806-3d05-5c23-9985-32e887a2c6fb",
      "name": "Audit",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        330
      ]
    },
    {
      "parameters": {
