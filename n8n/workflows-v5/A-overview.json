        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c67e4b32-222d-5b85-a1c8-37f159fcdbab",
      "name": "Audit Page",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        450
      ],
      "webhookId": "e071918c-30e4-54e2-96e7-776f76da9bb7"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT e.id, e.fields, e.flags, e.confidence, e.status, e.created_at, s.url, s.title, s.country, s.language, s.source_type\nFROM extractions e JOIN sources s ON s.id = e.source_id ORDER BY e.created_at DESC LIMIT 300",
        "options": {}
      },
      "id": "e85453ef-ca7e-5a56-8383-debfed8a68fe",
      "name": "Load Results",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        450
      ],
      "credentials": {
        "postgres": {
          "id": "ai4sgPostgres001",
          "name": "AI4SG Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// One card per result: fields + quotes, evidence flags, link to the source\nconst rows = $input.all().map(i => i.json).filter(r => r.id);\nconst esc = (s) => String(s ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst cards = rows.map(r => `<article><h3><a href=\"${esc(r.url)}\" target=\"_blank\">${esc(r.title || r.url)}</a></h3>\n  <p>${esc(r.country)} · ${esc(r.language)} · ${esc(r.source_type)} · confidence ${esc(r.confidence)} · ${esc((r.flags || []).join(', '))}</p>\n  <pre>${esc(JSON.stringify(r.fields, null, 2))}</pre></article>`).join('');\nreturn [{ json: { body: `<!doctype html><meta charset=\"utf-8\"><title>AI4SG Audit</title>\n  <style>body{font:14px system-ui;max-width:960px;margin:24px auto;padding:0 16px}article{border:1px solid #ddd;border-radius:8px;padding:12px;margin:12px 0}pre{white-space:pre-wrap}</style>\n  <h1>AI4SG · results to audit (${rows.length})</h1>${cards}` } }];\n"
      },
      "id": "4d43de4d-0f3a-5d46-bda4-a38fd1690a89",
      "name": "Render Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        450
      ]
    },
