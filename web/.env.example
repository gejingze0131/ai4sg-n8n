# Used by `npm run dev`; in Docker the same variables come from ../.env through ../docker-compose.yml.
DATABASE_URL_RO=postgres://web_ro:CHANGE_ME@localhost:5432/ai4sg   # reads the views in schema "api"
DATABASE_URL_RW=postgres://web_rw:CHANGE_ME@localhost:5432/ai4sg   # the website's own tables, the ai4sg_* functions

BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3001
# the address people use when this site is shared (./share.sh sets it in ../.env)
PUBLIC_URL=

# First administrator: the account is created when the site first starts. Nobody can register with this address.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# open = choosing "expert" at sign-up takes effect at once; approval = an administrator approves it first
EXPERT_SIGNUP=open

# Not used yet: set to true and fill SMTP_* to require e-mail verification and enable password reset
AUTH_REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# The pipeline (only src/pipeline/ talks to these)
N8N_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=CHANGE_ME
CODEX_RUNNER_URL=http://localhost:8787

# Map base layer: any MapLibre style. When it cannot be loaded the map falls back to public/geo.json.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
